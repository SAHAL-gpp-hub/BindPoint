# ==============================================================================
# BindPoint Production & Development Configuration Template
# ==============================================================================

# Server & Project Details
PROJECT_NAME="BindPoint"
ENVIRONMENT="production"            # "development" or "production"
DEBUG=false                         # false for production
PORT=8000
FRONTEND_URL="https://bindpoint.vercel.app"
SECRET_KEY="generate-a-secure-random-64-character-hex-string"

# Database Configuration
# Option A (Default for free Render Web Service - SQLite):
DATABASE_URL="sqlite+aiosqlite:///storage/print_station.db"
SYNC_DATABASE_URL="sqlite:///storage/print_station.db"

# Option B (Production PostgreSQL - e.g. Neon, Supabase, Render PostgreSQL):
# DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>"
# SYNC_DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>"

# Admin Authentication
# Only this single admin login record is created on first boot so you can log in.
# NO mock students, NO fake orders, and NO demo seed data are ever added on deployment.
ADMIN_EMAIL="admin@bindpoint.local"
ADMIN_PASSWORD="ChooseYourOwnStrongPassword123!"

# Payment Configuration (Manual UPI)
# The UPI VPA where students will send their payments
UPI_ID="yourname@okaxis"
# Payee name displayed in student UPI applications (Google Pay, PhonePe, Paytm)
PAYEE_NAME="BindPoint Print Station"
# Where and when students collect their physical printed reports
COLLECTION_INSTRUCTIONS="Collect your printed report from the Project Lab (Room 302) on weekdays between 3:00 PM and 5:00 PM. Present your Order ID or digital receipt at the counter."

# Business Logic & Storage
MAX_FILE_SIZE_MB=50
UNIQUE_PAISE_AMOUNT=false
FILE_RETENTION_DAYS=90
STORAGE_DIR="storage"

# Free Cloud Keep-Alive (Prevents 15-Minute Render Inactivity Sleep)
# Render automatically injects RENDER_EXTERNAL_URL. If you want to customize:
# KEEP_ALIVE_URL="https://your-backend.onrender.com"
KEEP_ALIVE_INTERVAL_SECONDS=240     # 4 minutes

# CORS for Vercel
CORS_ORIGIN_REGEX="^https://.*\.vercel\.app$"
