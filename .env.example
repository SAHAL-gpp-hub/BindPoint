# College Project Report Printing Management Web App
# Configuration Template

# Server & Environment
PROJECT_NAME="College Print Station"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
FRONTEND_URL="http://localhost:5173"
SECRET_KEY="replace-with-a-random-32-byte-hex-string-for-session-and-csrf"

# Database (PostgreSQL)
# Note: docker-compose runs Postgres on port 5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/print_station"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/print_station"

# Admin Authentication (Seeded at first boot with Argon2id)
ADMIN_EMAIL="admin@printstation.local"
ADMIN_PASSWORD="ChangeMeSecurePassword123!"

# Payment Configuration (Manual UPI)
# The VPA address where students will send payments
UPI_ID="yourname@okaxis"
# Payee name displayed in student UPI applications
PAYEE_NAME="College Print Station"
# Where and when students collect their physical reports
COLLECTION_INSTRUCTIONS="Collect your printed report from the Project Lab (Room 302, Main Building) on weekdays between 3:00 PM and 5:00 PM. Present your Order ID or digital receipt at the counter."

# Business Logic Configuration
MAX_FILE_SIZE_MB=50
UNIQUE_PAISE_AMOUNT=false
FILE_RETENTION_DAYS=90

# Storage Locations (relative to project root or absolute paths)
STORAGE_DIR="storage"
